    {
      "id": "generic-key-assignment",
      "class": "CREDENTIAL",
      "source": "(?:api[_-]?key|secret[_-]?key|access[_-]?token)\\s*[:=]\\s*['\"]?([A-Za-z0-9._~+/-]{16,}={0,2})['\"]?",
      "flags": "i",
      "validator": "notEmptyAssignmentTarget",
      "context": {
        "confidence": 0.8
      },
      "aiisId": null,
      "techniqueId": null,
      "fpEstimate": null,
      "note": "api_key=, secret_key=, access_token= assignments. = is admitted only as trailing base64 padding: a = followed by more characters is a second assignment. The separator keeps \\s* so a value on the line below its key (YAML block style) still reports; the validator rejects the case where the captured value is the next line's empty KEY=."
    },
