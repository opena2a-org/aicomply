{
  "schemaVersion": 1,
  "packVersion": "1.0.0",
  "referenceForms": [
    {
      "id": "env-dotted-accessor",
      "source": "^(?:globalThis\\.)?(?:process\\.env|import\\.meta\\.env|Deno\\.env)\\.[A-Za-z_][A-Za-z0-9_]*$",
      "note": "process.env.X, import.meta.env.VITE_X, Deno.env.X"
    },
    {
      "id": "env-bracket-accessor",
      "source": "^(?:globalThis\\.)?(?:process\\.env|import\\.meta\\.env|Deno\\.env|os\\.environ|ENV)\\s*\\[\\s*['\"][A-Za-z_][A-Za-z0-9_]*['\"]\\s*\\]$",
      "note": "process.env['X'], os.environ[\"X\"]"
    },
    {
      "id": "env-getter-call",
      "source": "^(?:os\\.environ\\.get|os\\.getenv|System\\.getenv|Deno\\.env\\.get|std::env::var)\\s*\\(\\s*['\"][A-Za-z_][A-Za-z0-9_]*['\"]\\s*\\)$",
      "note": "os.environ.get('X'), os.getenv('X'), System.getenv(\"X\")"
    },
    {
      "id": "env-interpolation",
      "source": "^\\$\\{?(?:env:)?[A-Za-z_][A-Za-z0-9_]*\\}?$",
      "note": "$X, ${X}, ${env:X}: the form opena2a protect writes into .mcp.json and .env-consuming config"
    }
  ],
  "patterns": [
