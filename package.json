{
  "name": "@opena2a/aicomply",
  "version": "2.0.0",
  "description": "Dual-layer compliance classifier for AI agent communications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "STATUS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "lint": "tsc --noEmit",
    "smoke-test": "node scripts/smoke-test.mjs",
    "accuracy:generate": "node bench/generate.mjs",
    "accuracy:measure": "npm run build && node bench/measure.mjs",
    "accuracy:update-baseline": "npm run build && node bench/measure.mjs --update-baseline"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opena2a-org/aicomply.git"
  },
  "homepage": "https://github.com/opena2a-org/aicomply",
  "bugs": {
    "url": "https://github.com/opena2a-org/aicomply/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@nanomind/daemon": "^0.2.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.6.1"
  }
}
